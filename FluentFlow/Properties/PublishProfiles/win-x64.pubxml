<?xml version="1.0" encoding="utf-8"?>
<!-- A self-contained, single-file build: the .NET runtime is inside FluentFlow.exe, so nothing has to be installed.
     Use it with:  dotnet publish FluentFlow/FluentFlow.csproj -c Release -p:PublishProfile=win-x64 -o publish -->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native libraries travel inside the exe too and are unpacked to %TEMP%\.net on the first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
