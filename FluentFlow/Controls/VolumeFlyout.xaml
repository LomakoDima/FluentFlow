<UserControl x:Class="FluentFlow.Controls.VolumeFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Focusable="True" FocusVisualStyle="{x:Null}" UseLayoutRounding="True"
             FontFamily="Segoe UI" TextElement.Foreground="{DynamicResource FlyoutTextBrush}"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource FlyoutSurfaceBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.32" Color="Black" />
        </Border.Effect>
        <Grid>
            <!-- Volume: mute toggle and percentage, slider, current output device (read-only). -->
            <Grid x:Name="MainView" Margin="14,12,14,10" PreviewMouseWheel="MainView_PreviewMouseWheel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource FlyoutIconButtonStyle}" Click="Mute_Click"
                            IsEnabled="{Binding HasDevice}"
                            ToolTip="Mute or unmute" AutomationProperties.Name="Mute"
                            Content="{Binding VolumeIcon}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" FontSize="20"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="Muted" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0"
                                   Foreground="{DynamicResource FlyoutSecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Slider x:Name="VolumeSlider" Grid.Row="1" Margin="2,4,2,0"
                        Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding HasDevice}"
                        AutomationProperties.Name="System volume">
                    <Slider.Style>
                        <Style TargetType="Slider" BasedOn="{StaticResource FlyoutSliderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>
                <Border Grid.Row="2" Height="1" Margin="0,8,0,6" Background="{DynamicResource FlyoutDividerBrush}" />
                <Grid Grid.Row="3" Margin="10,4,10,2" ToolTip="{Binding DeviceName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource FlyoutSecondaryTextBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
