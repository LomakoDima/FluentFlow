<Window x:Class="FluentFlow.Controls.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluentFlow taskbar widget" Width="128" Height="36"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        UseLayoutRounding="True">
    <!-- Hosted by TaskbarWidgetHost as a child of the Windows taskbar, so it must stay tiny and fully ours.
         The content (track title and visualizer) is a TaskbarWidgetView, added in code. -->
    <Border x:Name="Surface" CornerRadius="6" Cursor="Hand" ToolTip="FluentFlow: click to open"
            MouseLeftButtonUp="Surface_MouseLeftButtonUp" AutomationProperties.Name="Open FluentFlow">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Nearly transparent rather than null, so the whole widget is clickable. -->
                <Setter Property="Background" Value="#01000000" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#26808080" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource FlyoutContextMenuStyle}" Opened="ContextMenu_Opened">
                <MenuItem Header="Open FluentFlow" Style="{StaticResource FlyoutMenuItemStyle}" Click="Open_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Settings..." Style="{StaticResource FlyoutMenuItemStyle}" Click="Settings_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True"
                          Style="{StaticResource FlyoutMenuItemStyle}" Click="Startup_Click" />
                <Separator Style="{StaticResource FlyoutMenuSeparatorStyle}" />
                <MenuItem Header="Exit" Style="{StaticResource FlyoutMenuItemStyle}" Click="Exit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</Window>
