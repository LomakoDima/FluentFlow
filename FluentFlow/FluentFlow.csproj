<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version adds the SDK references needed for Windows.Media.Control. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon in Explorer, Start, the taskbar and Alt+Tab (source: branding/icon). -->
    <ApplicationIcon>Assets\FluentFlow.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Authors>DimaLab</Authors>
    <Product>FluentFlow</Product>
    <Description>Windows media controller with a taskbar audio visualizer</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon for the windows themselves, and the full-size mark for the settings' About card. -->
    <Resource Include="Assets\FluentFlow.ico" />
    <Resource Include="Assets\FluentFlow-256.png" />
  </ItemGroup>

</Project>
