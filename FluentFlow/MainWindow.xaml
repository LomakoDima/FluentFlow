<Window x:Class="FluentFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentFlow.Controls"
        Title="FluentFlow" Icon="pack://application:,,,/Assets/FluentFlow.ico" Width="448" Height="256"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowActivated="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource PlayerTextFont}" Foreground="{StaticResource PlayerTextBrush}"
        UseLayoutRounding="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- The card is 400 x 208; the transparent margin around it (MainWindow.ShadowMargin) holds its shadow. -->
    <Grid Margin="24">
        <!-- Depth. The shadow sits on its own plain shape, so it is drawn once and never again as the content moves. -->
        <Border CornerRadius="18" Background="#FF0D0D10" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.46" Color="Black"
                                  RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Card" Width="400" Height="208">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,400,208" RadiusX="18" RadiusY="18" />
            </Grid.Clip>
            <Border Background="{StaticResource PlayerSurfaceBrush}" />

            <!-- Ambient light: the cover itself, blurred far past recognition, glowing out from behind the cover and
                 dying away before the text. Two layers, so a new cover can dissolve over the old one. -->
            <Grid x:Name="Ambient" IsHitTestVisible="False" Opacity="0.62">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#C0000000" Offset="0.3" />
                        <GradientStop Color="#30000000" Offset="0.56" />
                        <GradientStop Color="#00000000" Offset="0.82" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <Grid.Effect>
                    <BlurEffect Radius="64" KernelType="Gaussian" RenderingBias="Performance" />
                </Grid.Effect>
                <Image x:Name="AmbientPrevious" Stretch="UniformToFill" Width="300" Height="300"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-62,-62,0,0" />
                <Image x:Name="AmbientCurrent" Stretch="UniformToFill" Width="300" Height="300"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-62,-62,0,0" />
            </Grid>
            <!-- Colour wash from the cover's palette (MainWindow sets the brush): carries the hue under the text, at a
                 darkness the palette controls, so the text never sits on a bright patch. -->
            <Border x:Name="Glow" IsHitTestVisible="False" Opacity="0.55" />
            <!-- A floor of shade under the timeline, so the time labels hold their contrast. -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00131317" Offset="0.55" />
                        <GradientStop Color="#99131317" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- The edge: a hairline that catches light along the top and fades down the sides. -->
            <Border CornerRadius="18" BorderThickness="1" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF" Offset="0" />
                        <GradientStop Color="#0DFFFFFF" Offset="0.45" />
                        <GradientStop Color="#14FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The cover: the largest thing in the player, lifted off the card by its own shadow. -->
                <Grid x:Name="ArtworkFrame">
                    <Border CornerRadius="12" Background="#FF1E1E23">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black"
                                              RenderingBias="Performance" />
                        </Border.Effect>
                    </Border>
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,140,140" RadiusX="12" RadiusY="12" />
                        </Grid.Clip>
                        <Image x:Name="ArtworkPrevious" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="ArtworkCurrent" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Album artwork" />
                    </Grid>
                    <!-- A hairline inside the edge keeps a dark cover from melting into the card. -->
                    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#1CFFFFFF" IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Status: a dot that takes the accent while music plays, and the state in small capitals. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                ToolTip="{Binding CurrentMedia.StatusMessage}">
                        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource PlayerTertiaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMedia.IsPlaying}" Value="True">
                                            <Setter Property="Fill" Value="{Binding (controls:PlayerAccent.Brush), RelativeSource={RelativeSource Self}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CurrentMedia.PlaybackLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PlayerTertiaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMedia.IsPlaying}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding (controls:PlayerAccent.Brush), RelativeSource={RelativeSource Self}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- No title bar: the window drags by its background, and these sit in the corner. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-6,-7,0">
                        <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE713;"
                                Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE921;"
                                Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                        <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                    </StackPanel>

                    <!-- Title over up to two lines (long titles are cut with an ellipsis and shown whole in the
                         tooltip), artist on one. -->
                    <StackPanel x:Name="TrackText" Grid.Row="1" Margin="0,7,0,0">
                        <TextBlock Text="{Binding CurrentMedia.Title}" ToolTip="{Binding CurrentMedia.Title}"
                                   FontFamily="{StaticResource PlayerDisplayFont}" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44" />
                        <TextBlock Text="{Binding CurrentMedia.Artist}" ToolTip="{Binding CurrentMedia.Artist}"
                                   FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource PlayerSecondaryTextBrush}" />
                    </StackPanel>

                    <Grid x:Name="TransportControls" Grid.Row="3" Margin="-7,0,-7,-3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Click="Previous_Click" IsEnabled="{Binding CurrentMedia.CanPrevious}"
                                    ToolTip="Previous track" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Previous track">
                                <Path Style="{StaticResource PlayerGlyphStyle}" Data="{StaticResource PreviousGlyphGeometry}" />
                            </Button>
                            <Button Style="{StaticResource PlayButtonStyle}" Click="PlayPause_Click" Margin="4,0"
                                    IsEnabled="{Binding CurrentMedia.CanPlayPause}"
                                    ToolTip="{Binding CurrentMedia.PlayPauseDescription}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding CurrentMedia.PlayPauseDescription}">
                                <!-- Both glyphs are always here; MainWindow swaps them with a small pop. The play
                                     triangle sits a hair right of centre, where the eye expects it. -->
                                <Grid Width="14" Height="14">
                                    <Path x:Name="PlayGlyph" Style="{StaticResource PlayerGlyphStyle}"
                                          Data="{StaticResource PlayGlyphGeometry}" Margin="1,0,-1,0" />
                                    <Path x:Name="PauseGlyph" Style="{StaticResource PlayerGlyphStyle}"
                                          Data="{StaticResource PauseGlyphGeometry}" Opacity="0" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource TransportButtonStyle}"
                                    Click="Next_Click" IsEnabled="{Binding CurrentMedia.CanNext}"
                                    ToolTip="Next track" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Next track">
                                <Path Style="{StaticResource PlayerGlyphStyle}" Data="{StaticResource NextGlyphGeometry}" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="VolumePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="VolumeControl" Style="{StaticResource TransportButtonStyle}"
                                    Foreground="{StaticResource PlayerSecondaryTextBrush}"
                                    Click="Volume_Click"
                                    ToolTip="{Binding VolumeDescription}"
                                    AutomationProperties.Name="Volume and output device">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Text="{Binding VolumeIcon}" />
                            </Button>
                            <!-- Zero-size in layout; opens as its own window anchored to the volume button. -->
                            <controls:FlyoutPopup x:Name="VolumeFlyoutPopup">
                                <controls:VolumeFlyout />
                            </controls:FlyoutPopup>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- The timeline runs under everything, cover included. -->
                <Grid x:Name="Timeline" Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentMedia.CurrentTime}" Style="{StaticResource TimeLabelStyle}" />
                    <!-- Maximum and Value are set from code (MainWindow.ShowProgress), which glides between the updates. -->
                    <controls:PlaybackTicks x:Name="Progress" Grid.Column="1" Height="14" Margin="12,0" Minimum="0"
                                            Foreground="{Binding (controls:PlayerAccent.Brush), RelativeSource={RelativeSource Self}}"
                                            TrackBrush="{StaticResource PlayerTrackBrush}"
                                            AutomationProperties.Name="Track progress" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentMedia.TotalTime}" Style="{StaticResource TimeLabelStyle}"
                               TextAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
