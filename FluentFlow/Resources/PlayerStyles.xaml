<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FluentFlow.Controls">
    <!-- The player is a dark, cinematic surface on every wallpaper. Its accent comes from the cover: MainWindow sets
         PlayerAccent.Brush on itself and recolours it, and everything here that uses the accent binds to it. -->
    <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#F7131317" />
    <SolidColorBrush x:Key="PlayerTextBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="PlayerSecondaryTextBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="PlayerTertiaryTextBrush" Color="#85FFFFFF" />
    <SolidColorBrush x:Key="PlayerHoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="PlayerTrackBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="PlayerOnAccentBrush" Color="#141418" />
    <!-- FluentFlow's own colour for the taskbar visualizer (the "FluentFlow" colour setting, TaskbarWidgetView). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D7AC99" />

    <FontFamily x:Key="PlayerDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="PlayerTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Hand-drawn transport glyphs on a 14 x 14 grid; filled and stroked with the same brush, so the corners are round. -->
    <Geometry x:Key="PlayGlyphGeometry">M2.5,1.2 L12.5,7 L2.5,12.8 Z</Geometry>
    <Geometry x:Key="PauseGlyphGeometry">M2.6,1.2 H5.2 V12.8 H2.6 Z M8.8,1.2 H11.4 V12.8 H8.8 Z</Geometry>
    <Geometry x:Key="PreviousGlyphGeometry">M12.6,2 L5,7 L12.6,12 Z M1.6,1.6 V12.4</Geometry>
    <Geometry x:Key="NextGlyphGeometry">M1.4,2 L9,7 L1.4,12 Z M12.4,1.6 V12.4</Geometry>

    <Style x:Key="PlayerGlyphStyle" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- Keyboard focus only (WPF shows focus visuals for keyboard focus): a ring in the cover's accent. -->
    <Style x:Key="PlayerFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{Binding (controls:PlayerAccent.Brush), RelativeSource={RelativeSource Self}}" BorderThickness="1.5" CornerRadius="999" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Previous, next, volume: a round plate that fades in on hover; the glyph dips when pressed and springs back. -->
    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverPlate" Background="{StaticResource PlayerHoverBrush}" CornerRadius="999" Opacity="0" />
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.84" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.84" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings, minimize, close: quiet until pointed at. -->
    <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource PlayerTertiaryTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Play and pause: a disc in the cover's accent with a dark glyph. Hover lifts it, a press squeezes it. -->
    <Style x:Key="PlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Background" Value="{Binding (controls:PlayerAccent.Brush), RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{StaticResource PlayerOnAccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <!-- Light from above: a faint sheen on the upper half, so the disc reads as an object, not a dot. -->
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                    <GradientStop Color="#14000000" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="HoverSheen" Fill="#2EFFFFFF" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#3DFFFFFF" />
                            <Setter Property="Foreground" Value="#99FFFFFF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TimeLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PlayerTextFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PlayerTertiaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Digits of equal width, so the clock doesn't wobble as it counts. -->
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Original flat vector placeholder: no image files or downloads required. -->
    <DrawingImage x:Key="FallbackArtwork">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,112,112" />
                </DrawingGroup.ClipGeometry>
                <GeometryDrawing Brush="#CE725B" Geometry="M0,0 H112 V112 H0 Z" />
                <GeometryDrawing Brush="#E8A086" Geometry="M0,0 H45 L0,76 Z" />
                <GeometryDrawing Brush="#B75444" Geometry="M0,112 L112,36 V112 Z" />
                <GeometryDrawing Brush="#272429">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="78,54" RadiusX="47" RadiusY="47" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#494047" Thickness="1" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="78,54" RadiusX="39" RadiusY="39" />
                            <EllipseGeometry Center="78,54" RadiusX="32" RadiusY="32" />
                            <EllipseGeometry Center="78,54" RadiusX="25" RadiusY="25" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E0AD92">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="78,54" RadiusX="14" RadiusY="14" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#272429">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="78,54" RadiusX="3" RadiusY="3" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F3D0BA" Geometry="M10,92 H29 V96 H10 Z M10,100 H44 V102 H10 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
