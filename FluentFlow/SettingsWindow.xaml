<Window x:Class="FluentFlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentFlow.Controls"
        xmlns:services="clr-namespace:FluentFlow.Services"
        Title="FluentFlow Settings" Width="780" Height="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource MacTextBrush}">
    <Border CornerRadius="12" Background="{DynamicResource MacWindowBrush}"
            BorderBrush="{DynamicResource MacBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: window buttons on top, then the sections. -->
            <Border Background="{DynamicResource MacSidebarBrush}" CornerRadius="11,0,0,11"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="18,18,0,0">
                        <Button Style="{StaticResource MacTrafficLightStyle}" Background="#FFFF5F57" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
                        <Button Style="{StaticResource MacTrafficLightStyle}" Background="#FFFEBC2E" Content="&#xE921;"
                                Margin="8,0,0,0" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                        <Button Style="{StaticResource MacTrafficLightStyle}" Background="#FF8E8E93" Margin="8,0,0,0"
                                IsEnabled="False" AutomationProperties.Name="Zoom (not available)" />
                    </StackPanel>
                    <ListBox x:Name="Sidebar" Grid.Row="1" Style="{StaticResource MacSidebarStyle}" Margin="10,4,10,0"
                             SelectionChanged="Sidebar_SelectionChanged" AutomationProperties.Name="Settings sections">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{Binding Tile}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content: page title, live preview, then the page. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown" Background="Transparent">
                    <TextBlock x:Name="PageTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="24,6,0,0" />
                </Grid>
                <Border x:Name="PreviewCard" Grid.Row="1" Style="{StaticResource MacCardStyle}" Margin="24,0,24,16"
                        Padding="10" Background="{DynamicResource MacCardBrush}">
                    <StackPanel>
                        <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center">
                            <Canvas x:Name="PreviewCanvas" Width="860" Height="48" />
                        </Viewbox>
                        <TextBlock x:Name="PreviewNote" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MacSecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,0,8">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <Grid Margin="24,0,24,12">
                        <!-- General -->
                        <StackPanel x:Name="GeneralPage">
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="Start with Windows" Description="Launch FluentFlow when you sign in.">
                                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource MacSwitchStyle}"
                                                  Click="StartupSwitch_Click" AutomationProperties.Name="Start with Windows" />
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MacCardStyle}">
                                <controls:MacRow Title="Reset all settings" Description="Put every option back to its default.">
                                    <Button Style="{StaticResource MacButtonStyle}" Content="Reset" Click="Reset_Click" />
                                </controls:MacRow>
                            </Border>
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="FluentFlow">
                                        <TextBlock x:Name="VersionText" FontSize="12.5"
                                                   Foreground="{DynamicResource MacSecondaryTextBrush}" />
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="License">
                                        <TextBlock Text="MIT" FontSize="12.5" Foreground="{DynamicResource MacSecondaryTextBrush}" />
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Position -->
                        <StackPanel x:Name="PositionPage" Visibility="Collapsed">
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="Alignment"
                                                     Description="Auto follows your Windows taskbar icon alignment: with centred icons the widget goes to the left edge, with left-aligned icons it sits by the notification area.">
                                        <ListBox x:Name="AlignmentList" Style="{StaticResource MacSegmentedStyle}" Width="270"
                                                 DisplayMemberPath="Label" SelectedValuePath="Value"
                                                 SelectedValue="{Binding Alignment, Mode=TwoWay}"
                                                 AutomationProperties.Name="Widget alignment" />
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Distance from the edge" Description="Extra space between the widget and the edge or icons it is aligned to.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="OffsetSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinEdgeOffset}"
                                                    Maximum="{x:Static services:AppSettings.MaxEdgeOffset}"
                                                    Value="{Binding EdgeOffset, Mode=TwoWay}" AutomationProperties.Name="Distance from the edge" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                            <TextBlock Text="COLOUR" Style="{StaticResource MacSectionHeaderStyle}" />
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="Visualizer colour">
                                        <ListBox x:Name="ColorModeList" Style="{StaticResource MacSegmentedStyle}" Width="270"
                                                 DisplayMemberPath="Label" SelectedValuePath="Value"
                                                 SelectedValue="{Binding ColorMode, Mode=TwoWay}"
                                                 AutomationProperties.Name="Visualizer colour source" />
                                    </controls:MacRow>
                                    <Border x:Name="CustomColorDivider" Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow x:Name="CustomColorRow" Title="Custom colour">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                                            <TextBox x:Name="HexBox" Style="{StaticResource MacTextBoxStyle}" Width="84" Margin="10,0,0,0"
                                                     MaxLength="9" LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"
                                                     AutomationProperties.Name="Custom colour (hex)" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Opacity">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="OpacitySlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinOpacity}"
                                                    Maximum="{x:Static services:AppSettings.MaxOpacity}"
                                                    Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Opacity" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="BARS" Style="{StaticResource MacSectionHeaderStyle}" />
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="Width">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="WidthSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinVisualizerWidth}"
                                                    Maximum="{x:Static services:AppSettings.MaxVisualizerWidth}"
                                                    Value="{Binding VisualizerWidth, Mode=TwoWay}" AutomationProperties.Name="Visualizer width" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=WidthSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Height">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="HeightSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinVisualizerHeight}"
                                                    Maximum="{x:Static services:AppSettings.MaxVisualizerHeight}"
                                                    Value="{Binding VisualizerHeight, Mode=TwoWay}" AutomationProperties.Name="Visualizer height" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=HeightSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Bar thickness">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="ThicknessSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinBarThickness}"
                                                    Maximum="{x:Static services:AppSettings.MaxBarThickness}"
                                                    Value="{Binding BarThickness, Mode=TwoWay}" AutomationProperties.Name="Bar thickness" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Corner radius">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="RadiusSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinBarRadius}"
                                                    Maximum="{x:Static services:AppSettings.MaxBarRadius}"
                                                    Value="{Binding BarRadius, Mode=TwoWay}" AutomationProperties.Name="Bar corner radius" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0.0} px}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Mirrored" Description="Bars grow up and down from the centre line.">
                                        <CheckBox Style="{StaticResource MacSwitchStyle}" IsChecked="{Binding Mirrored, Mode=TwoWay}"
                                                  AutomationProperties.Name="Mirrored bars" />
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SPACING" Style="{StaticResource MacSectionHeaderStyle}" />
                            <Border Style="{StaticResource MacCardStyle}">
                                <controls:MacRow Title="Side padding" Description="Space between the widget's edge and its content.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="PaddingSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                Minimum="{x:Static services:AppSettings.MinPadding}"
                                                Maximum="{x:Static services:AppSettings.MaxPadding}"
                                                Value="{Binding WidgetPadding, Mode=TwoWay}" AutomationProperties.Name="Side padding" />
                                        <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                   Text="{Binding Value, ElementName=PaddingSlider, StringFormat={}{0:0} px}" />
                                    </StackPanel>
                                </controls:MacRow>
                            </Border>
                        </StackPanel>

                        <!-- Track title -->
                        <StackPanel x:Name="TitlePage" Visibility="Collapsed">
                            <Border Style="{StaticResource MacCardStyle}">
                                <StackPanel>
                                    <controls:MacRow Title="Show track title" Description="Display what is playing to the left of the visualizer.">
                                        <CheckBox x:Name="ShowTitleSwitch" Style="{StaticResource MacSwitchStyle}"
                                                  IsChecked="{Binding ShowTitle, Mode=TwoWay}" AutomationProperties.Name="Show track title" />
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Include the artist" Description="Show &#x201C;Title &#x2013; Artist&#x201D;.">
                                        <CheckBox Style="{StaticResource MacSwitchStyle}" IsChecked="{Binding ShowArtist, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsChecked, ElementName=ShowTitleSwitch}"
                                                  AutomationProperties.Name="Include the artist" />
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Maximum width" Description="Longer titles are cut with an ellipsis.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="TitleWidthSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinTitleWidth}"
                                                    Maximum="{x:Static services:AppSettings.MaxTitleWidth}"
                                                    Value="{Binding TitleMaxWidth, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ShowTitleSwitch}"
                                                    AutomationProperties.Name="Title maximum width" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=TitleWidthSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                    <Border Style="{StaticResource MacDividerStyle}" />
                                    <controls:MacRow Title="Text size">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="TitleSizeSlider" Style="{StaticResource MacSliderStyle}" Width="170"
                                                    Minimum="{x:Static services:AppSettings.MinTitleFontSize}"
                                                    Maximum="{x:Static services:AppSettings.MaxTitleFontSize}"
                                                    Value="{Binding TitleFontSize, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsChecked, ElementName=ShowTitleSwitch}"
                                                    AutomationProperties.Name="Title text size" />
                                            <TextBlock Style="{StaticResource MacValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=TitleSizeSlider, StringFormat={}{0:0} pt}" />
                                        </StackPanel>
                                    </controls:MacRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
