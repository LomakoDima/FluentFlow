<Window x:Class="FluentFlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FluentFlow.Controls"
        xmlns:services="clr-namespace:FluentFlow.Services"
        Title="FluentFlow Settings" Icon="pack://application:,,,/Assets/FluentFlow.ico"
        Width="940" Height="660" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource SettingsWindowBrush}"
        FontFamily="{StaticResource SettingsTextFont}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Foreground="{DynamicResource SettingsTextBrush}">
    <!-- The title bar is part of the window's material (Mica, see WindowBackdrop): the top band drags the window and the
         caption buttons are drawn by the app. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand, in the title band. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <Image Source="{StaticResource FluentFlowMark}" Width="22" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="FluentFlow" FontFamily="{StaticResource SettingsDisplayFont}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,1" />
            <TextBlock Text="Settings" FontSize="14" Foreground="{DynamicResource SettingsTertiaryTextBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,1" />
        </StackPanel>

        <!-- Navigation rail. -->
        <Grid Grid.Row="1" Margin="12,8,12,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Top">
                <ListBox x:Name="Nav" Style="{StaticResource SettingsNavStyle}" SelectionChanged="Nav_SelectionChanged"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="16" Width="18"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,1" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The accent mark beside the active entry; it slides from entry to entry. -->
                <Canvas x:Name="NavIndicatorLayer" IsHitTestVisible="False">
                    <Border x:Name="NavIndicator" Canvas.Left="4" Width="3" Height="16" CornerRadius="1.5"
                            Background="{DynamicResource SettingsAccentBrush}" Visibility="Hidden" />
                </Canvas>
            </Grid>
            <TextBlock x:Name="VersionText" Grid.Row="1" Margin="16,0,0,0" FontSize="12"
                       Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
        </Grid>

        <!-- The content layer: raised a step above the material, with a hairline that catches the light at its top edge,
             as the player's card does. -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="12,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource SettingsLayerBrush}" BorderBrush="{DynamicResource SettingsLayerEdgeBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="Header" MaxWidth="860" Margin="40,30,40,0">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource SettingsPageTitleStyle}" />
                    <TextBlock x:Name="PageDescription" Style="{StaticResource SettingsCaptionTextStyle}" FontSize="13"
                               Margin="1,4,0,0" />
                </StackPanel>

                <!-- The stage: the real widget on a model of your taskbar, close up, with the whole taskbar above it and a
                     frame on the part in view. It stays put while the settings below scroll. -->
                <StackPanel x:Name="StageBlock" Grid.Row="1" MaxWidth="860" Margin="40,22,40,0">
                    <Border Style="{StaticResource SettingsCardStyle}" Height="164">
                        <Grid x:Name="StageViewport" ClipToBounds="True">
                            <!-- A faint lift towards the taskbar, like light off a desk. -->
                            <Border Background="{DynamicResource SettingsSubtleHoverBrush}" IsHitTestVisible="False">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.2" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Canvas x:Name="Camera" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Canvas x:Name="PreviewCanvas" Width="860" Height="48" />
                            </Canvas>

                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0"
                                        IsHitTestVisible="False">
                                <TextBlock Text="Whole taskbar" FontSize="11" Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
                                <Grid Margin="0,7,0,0" HorizontalAlignment="Left">
                                    <Rectangle x:Name="Overview" RadiusX="2" RadiusY="2" />
                                    <Border x:Name="Viewfinder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2"
                                            BorderThickness="1.5" CornerRadius="3" BorderBrush="{DynamicResource SettingsTextBrush}"
                                            Opacity="0.75" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,16,18,0" IsHitTestVisible="False">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Live preview" FontSize="11" Margin="7,0,0,0"
                                           Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewNote" Style="{StaticResource SettingsCaptionTextStyle}" Margin="4,10,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="PageScroller" Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <Grid MaxWidth="860" Margin="40,0,40,40">

                        <!-- General -->
                        <StackPanel x:Name="GeneralPage">
                            <TextBlock Text="Startup" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <controls:SettingRow Title="Start with Windows" Description="Open FluentFlow on the taskbar when you sign in.">
                                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource SettingsSwitchStyle}"
                                              Click="StartupSwitch_Click" AutomationProperties.Name="Start with Windows" />
                                </controls:SettingRow>
                            </Border>

                            <TextBlock Text="About" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The app icon itself. -->
                                    <Image Source="pack://application:,,,/Assets/FluentFlow-256.png" Width="64" Height="64"
                                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FluentFlow" FontFamily="{StaticResource SettingsDisplayFont}" FontSize="18"
                                                   FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
                                        <TextBlock Text="Media controls and a live audio visualizer for the Windows taskbar."
                                                   Style="{StaticResource SettingsCaptionTextStyle}" FontSize="13" Margin="0,2,0,0" />
                                        <TextBlock x:Name="AboutVersionText" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Reset" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow Title="Reset all settings"
                                                         Description="Puts every placement, visualizer and track title option back to its default. Start with Windows is left as it is.">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel x:Name="ResetDone" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,0,14,0" Visibility="Collapsed">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                           Foreground="{DynamicResource SettingsAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Back to defaults" FontSize="13" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource SettingsSecondaryTextBrush}" />
                                            </StackPanel>
                                            <Button x:Name="ResetButton" Style="{StaticResource SettingsButtonStyle}" Content="Reset…"
                                                    Click="ResetAsk_Click" AutomationProperties.Name="Reset all settings" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <!-- Asking first: a reset can't be undone. -->
                                    <StackPanel x:Name="ResetConfirm" Visibility="Collapsed">
                                        <Border Style="{StaticResource SettingsDividerStyle}" />
                                        <Grid Margin="18,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                           Foreground="{DynamicResource SettingsDangerBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Reset everything? This can't be undone." FontSize="13" Margin="10,0,16,0"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="ResetCancelButton" Style="{StaticResource SettingsButtonStyle}"
                                                        Content="Cancel" Click="ResetCancel_Click" IsCancel="False" />
                                                <Button Style="{StaticResource SettingsDangerButtonStyle}" Content="Reset settings"
                                                        Margin="8,0,0,0" Click="ResetConfirm_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Placement -->
                        <StackPanel x:Name="PlacementPage" Visibility="Collapsed">
                            <TextBlock Text="On the taskbar" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow x:Name="AlignmentRow" Title="Alignment">
                                        <controls:Segmented x:Name="AlignmentList" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                            SelectedValue="{Binding Alignment, Mode=TwoWay}"
                                                            AutomationProperties.Name="Widget alignment" />
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Distance from the edge"
                                                         Description="Extra space between the widget and the edge or icons it lines up with.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="OffsetSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinEdgeOffset}"
                                                    Maximum="{x:Static services:AppSettings.MaxEdgeOffset}"
                                                    Value="{Binding EdgeOffset, Mode=TwoWay}" AutomationProperties.Name="Distance from the edge" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Visualizer -->
                        <StackPanel x:Name="VisualizerPage" Visibility="Collapsed">
                            <TextBlock Text="Colour" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow Title="Bar colour"
                                                         Description="FluentFlow's own colour, your Windows accent colour, or one you choose.">
                                        <controls:Segmented x:Name="ColorModeList" SelectedValuePath="Value"
                                                            SelectedValue="{Binding ColorMode, Mode=TwoWay}"
                                                            AutomationProperties.Name="Visualizer colour source">
                                            <controls:Segmented.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Swatch}" Margin="0,0,8,0"
                                                                 VerticalAlignment="Center" Stroke="{DynamicResource SettingsControlStrokeBrush}" />
                                                        <TextBlock Text="{Binding Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </controls:Segmented.ItemTemplate>
                                        </controls:Segmented>
                                    </controls:SettingRow>
                                    <StackPanel x:Name="CustomColorPanel" Visibility="Collapsed">
                                        <Border Style="{StaticResource SettingsDividerStyle}" />
                                        <controls:SettingRow Title="Custom colour" Description="Pick one, or type a hex code such as #7FD1AE.">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                                                <TextBox x:Name="HexBox" Style="{StaticResource SettingsTextBoxStyle}" Width="96" Margin="12,0,0,0"
                                                         MaxLength="9" LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"
                                                         AutomationProperties.Name="Custom colour (hex)" />
                                            </StackPanel>
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Opacity" Description="How strongly the bars stand out from the taskbar.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="OpacitySlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinOpacity}"
                                                    Maximum="{x:Static services:AppSettings.MaxOpacity}"
                                                    Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Opacity" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Size" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow x:Name="WidthRow" Title="Width">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="WidthSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinVisualizerWidth}"
                                                    Maximum="{x:Static services:AppSettings.MaxVisualizerWidth}"
                                                    Value="{Binding VisualizerWidth, Mode=TwoWay}" AutomationProperties.Name="Visualizer width" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=WidthSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow x:Name="HeightRow" Title="Height">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="HeightSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinVisualizerHeight}"
                                                    Maximum="{x:Static services:AppSettings.MaxVisualizerHeight}"
                                                    Value="{Binding VisualizerHeight, Mode=TwoWay}" AutomationProperties.Name="Visualizer height" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=HeightSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Side padding" Description="Space between the widget's edge and what it shows.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="PaddingSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinPadding}"
                                                    Maximum="{x:Static services:AppSettings.MaxPadding}"
                                                    Value="{Binding WidgetPadding, Mode=TwoWay}" AutomationProperties.Name="Side padding" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=PaddingSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Bars" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow Title="Bar thickness" Description="How much of its slot each bar fills.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="ThicknessSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinBarThickness}"
                                                    Maximum="{x:Static services:AppSettings.MaxBarThickness}"
                                                    Value="{Binding BarThickness, Mode=TwoWay}" AutomationProperties.Name="Bar thickness" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Corner radius" Description="How round the ends of the bars are.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="RadiusSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinBarRadius}"
                                                    Maximum="{x:Static services:AppSettings.MaxBarRadius}"
                                                    Value="{Binding BarRadius, Mode=TwoWay}" AutomationProperties.Name="Bar corner radius" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0.0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Mirrored" Description="Bars grow both ways from the centre line.">
                                        <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding Mirrored, Mode=TwoWay}"
                                                  AutomationProperties.Name="Mirrored bars" />
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Track title -->
                        <StackPanel x:Name="TitlePage" Visibility="Collapsed">
                            <TextBlock Text="Title" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <controls:SettingRow x:Name="ShowTitleRow" Title="Show track title">
                                        <CheckBox x:Name="ShowTitleSwitch" Style="{StaticResource SettingsSwitchStyle}"
                                                  IsChecked="{Binding ShowTitle, Mode=TwoWay}" AutomationProperties.Name="Show track title" />
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Include the artist" Description="Show &#x201C;Title &#x2013; Artist&#x201D;."
                                                         IsEnabled="{Binding IsChecked, ElementName=ShowTitleSwitch}">
                                        <CheckBox Style="{StaticResource SettingsSwitchStyle}" IsChecked="{Binding ShowArtist, Mode=TwoWay}"
                                                  AutomationProperties.Name="Include the artist" />
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Text" Style="{StaticResource SettingsSectionHeaderStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" IsEnabled="{Binding IsChecked, ElementName=ShowTitleSwitch}">
                                <StackPanel>
                                    <controls:SettingRow Title="Maximum width" Description="Longer titles are cut short with an ellipsis.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="TitleWidthSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinTitleWidth}"
                                                    Maximum="{x:Static services:AppSettings.MaxTitleWidth}"
                                                    Value="{Binding TitleMaxWidth, Mode=TwoWay}" AutomationProperties.Name="Title maximum width" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=TitleWidthSlider, StringFormat={}{0:0} px}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                    <Border Style="{StaticResource SettingsDividerStyle}" />
                                    <controls:SettingRow Title="Text size">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="TitleSizeSlider" Style="{StaticResource SettingsSliderStyle}"
                                                    Minimum="{x:Static services:AppSettings.MinTitleFontSize}"
                                                    Maximum="{x:Static services:AppSettings.MaxTitleFontSize}"
                                                    Value="{Binding TitleFontSize, Mode=TwoWay}" AutomationProperties.Name="Title text size" />
                                            <TextBlock Style="{StaticResource SettingsValueLabelStyle}"
                                                       Text="{Binding Value, ElementName=TitleSizeSlider, StringFormat={}{0:0} pt}" />
                                        </StackPanel>
                                    </controls:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Caption buttons. -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource SettingsCaptionButtonStyle}" Content="&#xE921;" Click="Minimize_Click"
                    ToolTip="Minimize" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource SettingsCaptionButtonStyle}" Content="&#xE922;"
                    Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
            <Button Style="{StaticResource SettingsCloseButtonStyle}" Content="&#xE8BB;" Click="Close_Click"
                    ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>
</Window>
